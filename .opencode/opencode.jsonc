{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "shopify-dev-mcp": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "@shopify/dev-mcp@latest"]
    },
    "supabase": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.supabase.com/mcp?features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching%2Cfeedback"
    }
  }
}
