{
  "name": "sanavrm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "vitest",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:migrate": "tsx --env-file=.env ./node_modules/typeorm/cli.js migration:run -d ./src/lib/db/data-source.ts",
    "db:migrate:revert": "tsx --env-file=.env ./node_modules/typeorm/cli.js migration:revert -d ./src/lib/db/data-source.ts",
    "db:migrate:show": "tsx --env-file=.env ./node_modules/typeorm/cli.js migration:show -d ./src/lib/db/data-source.ts",
    "db:migration:generate": "tsx --env-file=.env ./node_modules/typeorm/cli.js migration:generate -d ./src/lib/db/data-source.ts",
    "db:migration:create": "tsx --env-file=.env ./node_modules/typeorm/cli.js migration:create"
  },
  "dependencies": {
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
